# Copy this file to .env (same folder) and set the paths for your machine.
# .env is ignored by git. Used by train.py / evaluate.py (via configs/paths.yaml),
# the scripts in scripts/ and the report scripts in report/.

# Python interpreter with the packages of requirements.txt (used by the shell scripts)
PYTHON=python

# Image dataset: folder containing Familly_split_no_ablation/, Familly_split_A1/, A2/, A6_classification/, A7/
DATASETS_DIR=/path/to/Datasets

# Fold tables, crosswalk, label tables, habitat names and dimorphism tables are
# inside the repository (data/, configs/): nothing to set for them.

# DINOv3: local clone of the facebookresearch/dinov3 repository, and folder with its pretrained weights
DINOV3_REPO=/path/to/dinov3
DINOV3_WEIGHTS_DIR=/path/to/dinov3_weights

# Optional: where scripts/extract_dinov3s_features.py writes its feature cache
# FEATURES_DIR=/path/to/Datasets
